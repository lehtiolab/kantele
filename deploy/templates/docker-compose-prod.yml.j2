services:
    web:
        network_mode: host
        depends_on:
            - db
            - mq
        env_file:
            - ./prod-container.env
        logging:
            driver: syslog
            options:
                syslog-address: "${SYSLOG_ADDRESS}"
        environment:
            PROTOCOL: https
            DB_HOST: "${HOST_FQDN}"
            RABBITHOST: "${HOST_FQDN}"
            KANTELEHOST: "${HOST_FQDN}"
        volumes:
            - "${HOST_UPLOADPATH}:${CONTAINER_UPLOADPATH}"
    
    nginx:
        network_mode: host
        depends_on:
            - web
        image: kantele_nginx # in prod-bake.yml
        volumes:
            - "${HOST_CERTBOT_PATH}/conf:/etc/letsencrypt"
            - "${HOST_CERTBOT_PATH}/www:/var/www/certbot"
          # here go the volumes from which we can task_download
{% for hostpath, mountpath, _url in nginx_download_mounts %}
          - "{{ hostpath }}:{{ mountpath }}:ro"
{% endfor %}
        logging:
            driver: syslog
            options:
                syslog-address: "{{ syslog_adress }}"

    certbot:
      image: certbot/certbot
      volumes:
        - "${HOST_CERTBOT_PATH}/conf:/etc/letsencrypt"
        - "${HOST_CERTBOT_PATH}/www:/var/www/certbot"
          #entrypoint: "/bin/sh -c 'trap exit TERM; while :; do certbot renew; sleep 12h & wait $${!}; done;'"  # Renew certificates every 12 hours
    db: 
        network_mode: host
        logging:
            driver: syslog
            options:
                syslog-address: "{{ syslog_adress }}"
        volumes:
            - "{{ pgdatadir }}:/var/lib/postgresql/data"
            - "{{ host_pgbackup_path }}:{{ container_backuppath }}"


    mq:
        network_mode: host
        logging:
            driver: syslog
            options:
                syslog-address: "{{ syslog_adress }}"
        volumes:
          - type: bind
            source: "{{ kanteledir }}/src/docker/rabbitmq-timeout.conf"
            target: /etc/rabbitmq/conf.d/30-timeout.conf


    jobrunner:
        depends_on:
            - web
            - mq
        network_mode: host
        env_file:
            - ./prod-container.env
        logging:
            driver: syslog
            options:
                syslog-address: "{{ syslog_adress }}"
        environment:
            DB_HOST: "${HOST_FQDN}"
            RABBITHOST: "${HOST_FQDN}"
