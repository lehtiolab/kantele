export INVENTORY_PATH=/path/to/ansible/inventory

export STORAGE_USER=firstname.lastname
export ANALYSIS_USER=firstname
export WEB_USER=username
export HPC_USER=username

export SSH_DIR=/home/username/.ssh
export LOCAL_SSH_KEY="${SSH_DIR}/id_rsa"
export HPC_SSH_KEYs="${SSH_DIR}/hpc_id_rsa ${SSH_DIR}/hpc2_id_rsa"

