# Upload paths in nginx container
web_container_uploadpath: /uploads
host_uploadpath: "{{ kanteledir }}/uploads"

# Certbot
host_certbot_path: "{{ kanteledir }}/certbot"
rsa_key_size: 4096

# Examples downloading raw files path in nginx container
# format is - [path_on_host, path_on_nginx, url_on_nginx]
# nginx_download_mounts:
#   - ['/path/to/storage', '/downloads/storage', '/download_url/storage']
#   - ['{{ host_uploadpath }}', '/downloads/uploads', '/download_url/up'] # first item is variable!
#   - ['/path/to/library', '/downloads/library', '/download_url/lib']

# For restoring backups
pgdatadir: "{{ homedir }}/pgdata"

dockercmd: "docker compose --env-file {{ compose_env_file }} -f src/docker/docker-compose-base.yml -f src/docker/docker-compose-prod.yml --project-name kantele"
